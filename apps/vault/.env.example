# The vault (apps/vault). Its own Railway service and database; never commit real values.
# Only VAULT_SHARED_SECRET is shared, with Go's service. Go's own variables are in apps/brain/.env.example.
PORT=8090                      # Go runs on 8080 locally
VAULT_DATABASE_URL=postgres://vault:vault@localhost:5432/vault   # its own database, never Go's
VAULT_MASTER_KEY=              # openssl rand -base64 32
GO_SPEND_PUBLIC_KEY=           # the Server's Ed25519 public key (PEM); this week the contract's test vector
VAULT_SHARED_SECRET=           # openssl rand -hex 32; the same value goes on Go's service
VAULT_PUBLIC_URL=http://localhost:8090
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8090
STRIPE_SECRET_KEY=             # sk_test_ or rk_test_ only; the vault refuses live keys
STRIPE_PUBLISHABLE_KEY=        # pk_test_ only
GO_CALLBACK_URL=http://localhost:8080   # Go's public URL (GO_PUBLIC_URL on the brain service)
