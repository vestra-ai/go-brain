# Go (apps/brain). On Railway these live on the brain service only; never commit real values.
# Optional variables are commented out until their lane lands.

# Lane A: the basics and the composer
PORT=8080
DATABASE_URL=postgres://go:go@localhost:5432/go
GO_SIGNING_SECRET=            # openssl rand -hex 32; the same value goes to the Server
GO_PUBLIC_URL=http://localhost:8080
ANTHROPIC_API_KEY=
COMPOSER_MODEL=claude-sonnet-5-5
SIDE_MODEL=claude-haiku-4-5
# MODEL_DAILY_BUDGET_USD=        # a hard cap per UTC day for the model calls, e.g. 20 on the try-room Go; unset is no cap
LOG_LEVEL=info

# Lane B (P2): Jev
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# REFLEX_LIVE=q1,q2,q4,q5,q6,q7,q8,q10    # live only where the test set passed; or off: no Jev call at all
# JEV_DEADLINE_MS=450
# JEV_DAILY_CALLS_PER_TRIP=5000

# Lane B (P2): memory. The fold's budgets in estimated tokens, and the quiet spells before side passes run.
# FOLD_AT_TOKENS=60000
# STORY_TOKENS=5000
# CHAT_HARD_CAP_TOKENS=90000
# NOTES_QUIET_MS=20000
# FOLD_QUIET_MS=60000

# Lane C (P4): the trip's computer through Vestra /v1, and travel
# VESTRA_API_URL=                # https://api-staging.vestra.ai this week
# VESTRA_API_KEYS=               # comma-separated vk_test_ keys with the runtime and setup scopes, all of one mode
# VESTRA_ADMIN_KEY=              # one key with the admin scope, same mode; only for the trip users
# VESTRA_WEBHOOK_SECRET=         # from setup-v1; two comma-separated secrets while one rolls
# VESTRA_DEPLOYMENT_ID=          # the go-trip-task deployment, printed by setup-v1
# VESTRA_MCP_SERVER_ID=          # Go's MCP server as /v1 knows it (mcp_...), printed by setup-v1
# VESTRA_RECIPE_DEPLOYMENT_ID=   # the go-recipe deployment (the fallback travel search), printed by setup-v1 --recipe-model
# TRAVEL_MODE=fake               # ixigo, ixigo_web (ixigo.com in the trip's browser, link only) or fake; the TRAVEL_MODE switch changes it at runtime. Without IXIGO_MCP_URL, ixigo searches use the fake.
# TRAVEL_RUNNER=agent_job        # how ixigo.com is read: agent_job (a job on the trip's computer) or browser_fetch (Bash's browser fetch); a switch too
# IXIGO_MCP_URL=                 # ixigo's MCP server (https://.../mcp); for the standalone fake: http://<host>:8788/mcp
# IXIGO_MCP_TOKEN=               # the bearer ixigo gave us (or the fake's FAKE_IXIGO_TOKEN)

# Lane D (P5): Go's side of the vault
# VAULT_URL=                     # https://vault.<Go's domain>; money stays off until this and the secret are set
# VAULT_SHARED_SECRET=           # openssl rand -hex 32; the same value goes on the vault's service
# PAY_RAIL=fake                  # fake, stripe_test or ixigo; the PAY_RAIL switch changes it at runtime

# P6: calls
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# OPENAI_API_KEY=
# CALLS_MODE=off
# CALLS_ALLOWLIST=              # e.g. "Villa Sol=+919800000001,+919800000002"; a name lets Go call by name
# CALLS_VOICE_MODEL=gpt-realtime-2.1   # gpt-live-1 for the day-one A/B; never a transcriber

# P7: the admin page
# ADMIN_TOKEN=
# GO_ROLE=stage                 # stage on brain, rehearsal on brain-rehearsal; the rehearsal runner runs only on rehearsal
# RAILWAY_SERVICE_NAME=         # set by Railway; GO_ROLE's fallback
