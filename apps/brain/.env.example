# Go (apps/brain). On Railway these live on the brain service only; never commit real values.
# Optional variables are commented out until their lane lands.

# Lane A: the basics and the composer
PORT=8080
DATABASE_URL=postgres://go:go@localhost:5432/go
GO_SIGNING_SECRET=            # openssl rand -hex 32; the same value goes to the Server
GO_PUBLIC_URL=http://localhost:8080
ANTHROPIC_API_KEY=
COMPOSER_MODEL=claude-sonnet-5-5
SIDE_MODEL=claude-haiku-4-5
LOG_LEVEL=info

# Lane B (P2): Jev
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# REFLEX_LIVE=q1,q2,q3          # or off: no Jev call at all

# Lane C (P4): the trip's computer through Vestra /v1, and travel
# VESTRA_API_URL=
# VESTRA_API_KEYS=
# VESTRA_WEBHOOK_SECRET=
# VESTRA_DEPLOYMENT_ID=
# TRAVEL_MODE=fake
# IXIGO_MCP_URL=
# IXIGO_MCP_TOKEN=

# Lane D (P5): Go's side of the vault
# VAULT_URL=
# VAULT_SHARED_SECRET=
# PAY_RAIL=fake

# P6: calls
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# OPENAI_API_KEY=
